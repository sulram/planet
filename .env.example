# Copy to .env. Bun loads it for every script in scripts/.

# Public URL of the web app: magic links point here.
APP_URL=http://localhost:5173
APP_NAME=planet

# Where the web app finds the server.
PB_URL=http://127.0.0.1:8090

# SMTP. Empty host = mail off: the server prints each magic link to its log.
# For Mailpit (brew install mailpit): SMTP_HOST=127.0.0.1 and SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=planet@planet.localhost

# This account becomes an operator on start: it may use /backoffice.
PLANET_OPERATOR_EMAIL=operator@planet.localhost

# Superuser of the PocketBase panel (http://127.0.0.1:8090/_/), upserted by scripts/server.ts.
PB_SUPERUSER_EMAIL=dev@planet.localhost
PB_SUPERUSER_PASSWORD=dev-superuser-1234
