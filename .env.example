# Copy to .env. Bun loads it for every script in scripts/.

# Public URL of the web app: magic links point here.
APP_URL=http://localhost:5173
APP_NAME=planet

# Where the web app finds the server, and where a browser reaches it for the
# world socket (the same address unless a proxy sits between them).
PB_URL=http://127.0.0.1:8090
PB_PUBLIC_URL=http://127.0.0.1:8090

# SMTP. Dev default is Mailpit (brew install mailpit), started by `bun run dev`:
# inbox at http://localhost:8025. Empty host = mail off: the server prints each
# magic link to its log instead.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=planet@planet.localhost

# This account becomes an operator on start: it may use /backoffice.
PLANET_OPERATOR_EMAIL=operator@planet.localhost

# Superuser of the PocketBase panel (http://127.0.0.1:8090/_/), upserted by scripts/server.ts.
PB_SUPERUSER_EMAIL=dev@planet.localhost
PB_SUPERUSER_PASSWORD=dev-superuser-1234

# Where `bun run provision` and `bun run deploy` go, per environment. The box
# holds its own runtime env at /etc/planet/<env>.env (docs/DEPLOY.md).
DEPLOY_PRODUCTION_HOST=root@1.2.3.4
DEPLOY_PRODUCTION_DOMAIN=planet.example.org
# 443, or another port while something else holds 443 on that box.
DEPLOY_PRODUCTION_HTTPS_PORT=443
# amd64 or arm64.
DEPLOY_PRODUCTION_ARCH=amd64
