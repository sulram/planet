# Copy to .env. Bun loads it for every script in scripts/.

# Alone, every session has this level: anonymous, signed_in,
# builder or admin. Unset, `bun run dev` and `bun run server` say admin, so
# the one at the keyboard founds the world and builds.
# PLANET_DEV_LEVEL=admin

# Where the world keeps itself. Unset, server/world.
# WORLD_DIR=

# Under mundos (docs/DEPLOY.md) these three come together and stand in place
# of the level above: the key that checks its tokens (PEM, newlines escaped),
# its origin, and the world's name there.
# MUNDOS_PUBLIC_KEY=
# PUBLIC_MUNDOS_URL=
# PUBLIC_MUNDOS_WORLD=
